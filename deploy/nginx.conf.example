# /etc/nginx/conf.d/superdevops-service.conf
# Replace devops.example.com, then get a certificate:  certbot --nginx -d devops.example.com
server {
    listen 80;
    server_name devops.example.com;

    # Optional but recommended: only your office / VPN addresses may reach the service.
    # allow 203.0.113.10;
    # allow 198.51.100.0/24;
    # deny all;

    client_max_body_size 2g;          # site uploads pass through here

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;      # the app talks over a WebSocket
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1h;                       # long deploys and terminals
        proxy_send_timeout 1h;
        proxy_request_buffering off;                 # stream uploads straight through
    }
}
