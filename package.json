{
  "name": "superdevops",
  "version": "1.1.0",
  "description": "Team DevOps manager: a central service plus a desktop app",
  "main": "./out/main/index.js",
  "author": "Apsara Panel",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "server:dev": "tsx src/server/main.ts --dev-no-2fa",
    "server:dev:2fa": "tsx src/server/main.ts",
    "server:build": "esbuild src/server/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-server/server.js --alias:@shared=./src/shared --external:cpu-features --external:*.node --external:bufferutil --external:utf-8-validate --log-level=warning",
    "server:start": "node dist-server/server.js",
    "dist:mac": "electron-vite build && electron-builder --mac && rm -rf release/mac release/mac-arm64",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "ssh2": "^1.17.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.6.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/manrope": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.29.3",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.superdevops.desktop",
    "productName": "Apsara Panel",
    "copyright": "Copyright © 2026 Apsara Panel",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "resources/**",
      "package.json",
      "!**/node_modules/cpu-features/**",
      "!**/node_modules/ssh2/lib/protocol/crypto/build/**",
      "!**/node_modules/nan/**",
      "!**/*.{md,map,ts}",
      "!**/node_modules/*/{test,tests,examples,docs}/**"
    ],
    "asar": true,
    "artifactName": "ApsaraPanel-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "dmg": {
      "title": "Apsara Panel ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Apsara Panel"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "publish": null,
    "npmRebuild": false
  },
  "desktopName": "superdevops.desktop"
}
